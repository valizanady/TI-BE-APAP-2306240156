meta {
  name: POST Create Bundle - Simple (1 Plan, 1 Activity)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/package/create-bundle
  body: json
  auth: none
}

body:json {
  {
    "packageName": "Paket Simple Test",
    "userId": "user-001",
    "quota": 5,
    "startDate": "2025-12-10T08:00:00",
    "endDate": "2025-12-10T18:00:00",
    "plans": [
      {
        "planName": "Morning Activity",
        "activityType": "Outdoor",
        "startDate": "2025-12-10T09:00:00",
        "endDate": "2025-12-10T12:00:00",
        "startLocation": "Jakarta",
        "endLocation": "Jakarta",
        "orderedActivities": [
          {
            "activityId": "ACT-001",
            "orderedQuantity": 5
          }
        ]
      }
    ]
  }
}

tests {
  test("Status should be 201", function() {
    expect(res.status).to.equal(201);
  });
  
  test("Package should be created", function() {
    expect(res.body.data.packageId).to.contain('PACK-user-001');
  });
  
  test("Should have 1 plan", function() {
    expect(res.body.data.createdPlans).to.have.lengthOf(1);
  });
  
  test("Plan should be Fulfilled", function() {
    expect(res.body.data.createdPlans[0].status).to.equal('Fulfilled');
  });
}
