meta {
  name: POST Create Bundle - Jogja Multiple Plans
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/package/create-bundle
  body: json
  auth: none
}

body:json {
  {
    "packageName": "Paket Wisata Jogja",
    "userId": "user-jogja-001",
    "quota": 10,
    "startDate": "2025-12-01T08:00:00",
    "endDate": "2025-12-15T18:00:00",
    "plans": [
      {
        "planName": "Hotel Accommodation",
        "activityType": "Accommodation",
        "startDate": "2025-12-11T09:00:00",
        "endDate": "2025-12-12T17:00:00",
        "startLocation": "KABUPATEN SIMEULUE",
        "endLocation": "KABUPATEN SIMEULUE",
        "orderedActivities": [
          {
            "activityId": "57a5ea63-def5-4c6b-8240-aaa0eb0b422b",
            "orderedQuantity": 10
          }
        ]
      }
    ]
  }
}

docs {
  # Request ini sudah diperbaiki dari error sebelumnya:
  
  ❌ MASALAH SEBELUMNYA:
  1. Ada trailing comma setelah object terakhir di array: `"orderedQuantity": 5},`
  2. Ada empty object di array plans: `{}`
  
  ✅ SUDAH DIPERBAIKI:
  1. Tidak ada trailing comma
  2. Tidak ada empty object
  3. JSON valid dan siap digunakan
}

tests {
  test("Status should be 201", function() {
    expect(res.status).to.equal(201);
  });
  
  test("Response should have packageId", function() {
    expect(res.body.data).to.have.property('packageId');
    expect(res.body.data.packageId).to.contain('PACK-user-jogja-001');
  });
  
  test("Should have 1 plan", function() {
    expect(res.body.data.createdPlans).to.have.lengthOf(1);
  });
  
  test("Plan should be Fulfilled", function() {
    expect(res.body.data.createdPlans[0].status).to.equal('Fulfilled');
  });
}
