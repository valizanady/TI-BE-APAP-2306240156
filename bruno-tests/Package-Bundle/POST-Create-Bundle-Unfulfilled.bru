meta {
  name: POST Create Bundle - Unfulfilled Plan
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/package/create-bundle
  body: json
  auth: none
}

body:json {
  {
    "packageName": "Paket Flexible Schedule",
    "userId": "user-003",
    "quota": 15,
    "startDate": "2025-12-20T08:00:00",
    "endDate": "2025-12-22T18:00:00",
    "plans": [
      {
        "planName": "First Day Activities",
        "activityType": "Outdoor",
        "startDate": "2025-12-20T09:00:00",
        "endDate": "2025-12-20T17:00:00",
        "startLocation": "Bali",
        "endLocation": "Bali",
        "orderedActivities": [
          {
            "activityId": "ACT-BALI-001",
            "orderedQuantity": 8
          }
        ]
      },
      {
        "planName": "Second Day Exploration",
        "activityType": "Cultural",
        "startDate": "2025-12-21T08:00:00",
        "endDate": "2025-12-21T16:00:00",
        "startLocation": "Ubud",
        "endLocation": "Ubud",
        "orderedActivities": [
          {
            "activityId": "ACT-UBUD-001",
            "orderedQuantity": 5
          }
        ]
      }
    ]
  }
}

docs {
  # Contoh dengan Plan Unfulfilled
  
  Plan pertama: 8 ordered quantity (< 15 quota) → Status: Unfulfilled
  Plan kedua: 5 ordered quantity (< 15 quota) → Status: Unfulfilled
  
  Total: 13 ordered quantity (< 15 quota package)
  
  Ini menunjukkan bahwa plan bisa tetap dibuat meskipun belum mencapai quota penuh.
}

tests {
  test("Status should be 201", function() {
    expect(res.status).to.equal(201);
  });
  
  test("Should have 2 plans", function() {
    expect(res.body.data.createdPlans).to.have.lengthOf(2);
  });
  
  test("Plans should be Unfulfilled", function() {
    const hasUnfulfilled = res.body.data.createdPlans.some(plan => plan.status === 'Unfulfilled');
    expect(hasUnfulfilled).to.be.true;
  });
}
