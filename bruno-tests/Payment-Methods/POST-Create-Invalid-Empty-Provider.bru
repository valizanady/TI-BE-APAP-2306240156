meta {
  name: POST Create - Invalid Empty Provider
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/payment-methods
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superadminToken}}
}

body:json {
  {
    "methodName": "Credit Card",
    "provider": ""
  }
}

tests {
  test("should return 400 Bad Request", function() {
    expect(res.status).to.equal(400);
  });
  
  test("should have error message", function() {
    const body = res.getBody();
    expect(body.message).to.include("Provider");
  });
}

docs {
  # POST Create Payment Method - Invalid Empty Provider
  
  **Test Case:** Validation for empty `provider`
  
  ## Expected Behavior
  - Returns **400 Bad Request**
  - Error message: "Provider is required" or similar
  
  ## Request Body
  ```json
  {
    "methodName": "Credit Card",
    "provider": ""  // ❌ Empty string
  }
  ```
}
