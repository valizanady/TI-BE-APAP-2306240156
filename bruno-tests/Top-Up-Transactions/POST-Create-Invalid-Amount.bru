meta {
  name: POST Create Top Up Transaction - Invalid Amount
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{CUSTOMER_TOKEN}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerId": "{{CUSTOMER_ID}}",
    "amount": -100000,
    "paymentMethodId": "{{PAYMENT_METHOD_ID}}"
  }
}

tests {
  test("Status code is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  
  test("Response has error message about amount", function() {
    const data = res.getBody();
    expect(data.message).to.include("Amount must be positive");
  });
}

docs {
  # Test Case: Invalid Amount (Negative)
  
  This test verifies that the API rejects negative amounts.
  
  ## Expected Result
  - Status: 400 Bad Request
  - Message: "Amount must be positive"
  
  ## Test Scenarios
  1. Negative amount: -100000
  2. Zero amount: 0
  3. Null amount: null
}
