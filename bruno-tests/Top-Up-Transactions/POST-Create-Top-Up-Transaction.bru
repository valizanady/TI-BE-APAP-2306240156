meta {
  name: POST Create Top Up Transaction
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{CUSTOMER_TOKEN}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerId": "{{CUSTOMER_ID}}",
    "amount": 100000,
    "paymentMethodId": "{{PAYMENT_METHOD_ID}}"
  }
}

tests {
  test("Status code is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Response has success message", function() {
    const data = res.getBody();
    expect(data.message).to.equal("Top-up transaction created successfully");
  });
  
  test("Transaction status is Pending", function() {
    const data = res.getBody();
    expect(data.data.status).to.equal("Pending");
  });
  
  test("Transaction has correct amount", function() {
    const data = res.getBody();
    expect(data.data.amount).to.equal(100000);
  });
  
  test("Transaction has customerId", function() {
    const data = res.getBody();
    expect(data.data.customerId).to.exist;
  });
}

docs {
  # POST Create Top Up Transaction
  
  ## Description
  Create a new top-up transaction for a customer. The transaction will be created with status "Pending" and requires admin approval.
  
  ## Authorization
  - **Customer**: Can create top-up transactions
  - Token required: Yes (JWT Bearer token)
  
  ## Request Body
  ```json
  {
    "customerId": "uuid-string",
    "amount": 100000,
    "paymentMethodId": "uuid-string"
  }
  ```
  
  ## Validations
  - `customerId`: Required, must be valid UUID
  - `amount`: Required, must be positive (> 0)
  - `paymentMethodId`: Required, must be valid UUID and payment method must be Active
  
  ## Success Response (201 Created)
  ```json
  {
    "status": 201,
    "message": "Top-up transaction created successfully",
    "data": {
      "id": "uuid-string",
      "customerId": "uuid-string",
      "amount": 100000,
      "paymentMethod": {
        "id": "uuid-string",
        "methodName": "Bank Transfer",
        "provider": "BCA",
        "status": "Active"
      },
      "status": "Pending",
      "createdAt": "2025-11-24T10:30:00",
      "updatedAt": "2025-11-24T10:30:00"
    }
  }
  ```
  
  ## Error Responses
  
  ### 400 Bad Request - Invalid Amount
  ```json
  {
    "status": 400,
    "message": "Amount must be positive",
    "data": null
  }
  ```
  
  ### 400 Bad Request - Payment Method Not Active
  ```json
  {
    "status": 400,
    "message": "Payment method is not active",
    "data": null
  }
  ```
  
  ### 404 Not Found - Payment Method Not Found
  ```json
  {
    "status": 404,
    "message": "Payment method not found",
    "data": null
  }
  ```
  
  ## Testing Steps
  
  1. **Get Customer Token**
     - Login as Customer to get JWT token
     - Set `CUSTOMER_TOKEN` in Bruno environment
  
  2. **Get Customer ID**
     - Parse JWT token or get from profile
     - Set `CUSTOMER_ID` in Bruno environment
  
  3. **Get Active Payment Method ID**
     - Call GET /payment-methods endpoint
     - Copy an active payment method ID
     - Set `PAYMENT_METHOD_ID` in Bruno environment
  
  4. **Create Transaction**
     - Run this request
     - Verify status 201 and transaction has status "Pending"
  
  5. **Verify in Database**
     ```sql
     SELECT * FROM topup_transaction 
     WHERE customer_id = 'your-customer-id' 
     ORDER BY created_at DESC;
     ```
}
