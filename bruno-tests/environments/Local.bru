vars {
  BASE_URL: http://localhost:8080
  PROFILE_SERVICE_URL: https://acc-be.beel.my.id/api
  
  # JWT Tokens (replace with actual tokens from Profile Service)
  CUSTOMER_TOKEN: your-customer-jwt-token-here
  SUPERADMIN_TOKEN: your-superadmin-jwt-token-here
  
  # User IDs (extracted from JWT tokens)
  CUSTOMER_ID: customer-uuid-here
  SUPERADMIN_ID: superadmin-uuid-here
  
  # Payment Method IDs (get from GET /payment-methods)
  PAYMENT_METHOD_ID: payment-method-uuid-here
  
  # Transaction IDs (will be filled after creating transactions)
  TRANSACTION_ID: transaction-uuid-here
}

vars:secret [
  # Add sensitive tokens here
  # CUSTOMER_TOKEN,
  # SUPERADMIN_TOKEN
]
