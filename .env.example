# Backend Environment Variables
# Copy this file to .env and update with your values

# ==============================================
# CORS Configuration
# ==============================================
# Comma-separated list of allowed origins (no spaces)
# Include protocol (http:// or https://)
# No trailing slashes

# Development (local frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Production (single domain)
# CORS_ALLOWED_ORIGINS=https://your-frontend.com

# Production (multiple domains)
# CORS_ALLOWED_ORIGINS=https://your-frontend.com,https://www.your-frontend.com

# Production + Development (both)
# CORS_ALLOWED_ORIGINS=https://your-frontend.com,http://localhost:5173

# Vercel Deployment
# CORS_ALLOWED_ORIGINS=https://yourapp.vercel.app,https://yourapp-git-main.vercel.app

# Netlify Deployment
# CORS_ALLOWED_ORIGINS=https://yourapp.netlify.app
